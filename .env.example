# ============================================================================
#  Local RAG configuration  -  everything here runs on your machine, for free.
# ============================================================================

# You do not have to edit this file. On the first run the app asks for the folder
# holding your documents and for an API key, then writes both to your own profile
# (%APPDATA%\LocalRAG on Windows, ~/.config/local-rag on Linux). Copy this file to
# .env only if you would rather keep the settings beside the code, or to reach the
# tuning knobs further down.

# --- WHERE YOUR DOCUMENTS LIVE ---------------------------------------------
# The folder to index; sub-folders are included automatically.
# DATA_DIR=D:/data

# Where the index itself is kept (SQLite + vectors + downloaded models).
# STORAGE_DIR=./storage

# --- THE MODEL THAT WRITES THE ANSWERS --------------------------------------
# Either key alone is enough; setting both lets the dropdown switch between them.
#   Groq    https://console.groq.com/keys        free tier, very fast
#   Gemini  https://aistudio.google.com/apikey   free tier, large context
# GROQ_API_KEY=
# GEMINI_API_KEY=

# Which provider a new chat starts with. Models are addressed provider::model,
# e.g. groq::openai/gpt-oss-120b. Leave LLM_MODEL blank to take the first one
# the provider offers.
LLM_BACKEND=groq
LLM_MODEL=
TEMPERATURE=0.2
MAX_TOKENS=1024
# Earlier turns of the conversation sent with each question.
HISTORY_TURNS=6

# Anything else that speaks the OpenAI protocol -- LM Studio, OpenRouter, vLLM.
# Pointing this at a model on your own machine keeps the passages local too.
# OPENAI_BASE_URL=http://localhost:1234/v1
# OPENAI_API_KEY=not-needed

# --- EMBEDDINGS (local ONNX, downloaded once) ------------------------------
EMBED_BACKEND=auto
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH=64

# --- RETRIEVAL --------------------------------------------------------------
TOP_K=5
CANDIDATES_DENSE=40
CANDIDATES_BM25=40
RERANK_ENABLED=true
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# How many fused candidates the cross-encoder rescores. This is the biggest local
# cost in answering a question -- roughly 0.1s each on a CPU -- and the main
# quality/latency dial. 0 means 4x TOP_K. Lower it if answers feel slow; raise it
# if the right passage is being found but not ranked first.
RERANK_CANDIDATES=0
# A hard ceiling on that number, whatever the arithmetic above asks for. Reranking
# is linear in candidates: at TOP_K=200 the uncapped figure was 800 candidates and
# roughly two minutes. Measured, depth 32 and depth 40 returned the same ordering.
RERANK_MAX_CANDIDATES=48
NEIGHBOR_WINDOW=0

# --- APPROXIMATE SEARCH -----------------------------------------------------
# Exact search multiplies every vector by the query. Below a few hundred thousand
# chunks that is one BLAS call and it is exact, so it stays. Above it, the cost is
# the size of the corpus: at 20M documents the vectors are 143 GB and one query
# would read all of them.
#
# Past ANN_MIN_VECTORS an IVF-PQ index takes over. Vectors are clustered so a query
# visits a few cells instead of all of them, and each is compressed from 1536 bytes
# to 32, which is what lets the index stay in memory. The float32 vectors remain the
# source of truth and anything the index does not cover yet is searched exactly, so
# an answer is never stale.
ANN_ENABLED=true
ANN_MIN_VECTORS=200000
# Cells visited per query: the accuracy/latency dial, and a floor.
ANN_NPROBE=64
# Accuracy tracks the share of the corpus a query examines, and cells grow with the
# corpus -- so a fixed probe count scans less and less as the index grows. Measured,
# 64 probes covered 8% of a 60k corpus (recall 0.98) but 1.1% of a 2M one (0.74).
# This holds the share constant instead. Set it to 0 for constant query cost and
# accept that recall then falls away as the index grows.
ANN_SCAN_FRACTION=0.02
# Candidates handed from the approximate pass to the exact re-score. The re-score
# is what makes the final ordering exact rather than approximate.
ANN_SHORTLIST=512
ANN_CELLS=0
ANN_REBUILD_AFTER=100000
MAX_CONTEXT_CHARS=6000

# --- CHUNKING ---------------------------------------------------------------
CHUNK_CHARS=1400
CHUNK_OVERLAP=200

# --- INGESTION --------------------------------------------------------------
MAX_FILE_MB=200
INGEST_WORKERS=8
# Re-indexing a file appends new vectors and abandons the old ones, so the vector
# file grows with every run and every search reads the dead rows too. When this
# fraction of it is dead, an index run rewrites the file. 0 turns that off.
VECTOR_COMPACT_RATIO=0.25

# --- OCR: reads text out of pictures ----------------------------------------
# Covers standalone images, scanned PDFs, and images embedded inside Word,
# PowerPoint, Excel and PDF files. Engine "auto" prefers RapidOCR
# (pip install rapidocr-onnxruntime - no separate installer needed).
OCR_ENABLED=true
OCR_ENGINE=auto
OCR_WORKERS=2
OCR_MAX_IMAGES_PER_FILE=60
OCR_IMAGE_MIN_PX=90
OCR_MIN_CHARS=60
OCR_DPI=200
# Only used when the engine is Tesseract:
# OCR_LANG=eng
# TESSERACT_CMD=C:/Program Files/Tesseract-OCR/tesseract.exe

# --- SPREADSHEETS AS TABLES -------------------------------------------------
# A sheet with a header row and more than a handful of rows is loaded into
# storage/tables.db and queried with generated SQL instead of being embedded.
# That is the only way to answer "how many" or "what is the total" correctly:
# top-k retrieval can only ever show the model a few rows out of the whole sheet.
TABLES_ENABLED=true
# Distinct values per column shown to the model. Raise it if the model keeps
# guessing the wrong spelling for a category; lower it to shrink the prompt.
TABLE_ENUM_MAX=40
# Rows a single query may hand back to the model.
TABLE_MAX_ROWS=200
# Sheets smaller than this stay on the normal text path.
TABLE_MIN_ROWS=5
TABLE_SQL_TIMEOUT=20
# An upper bound on rows any single generated query may scan, so a careless or
# hostile query cannot return a hundred megabytes and stall the server.
TABLE_ROW_CEILING=50000
# Writing the query happens before anything can stream, so it gets a tight budget.
# If the provider is slower than this, the question falls back to document search
# rather than leaving you in front of a spinner.
TABLE_PLAN_TIMEOUT=25
TABLE_SQL_RETRIES=1

# --- UNDERSTANDING THE QUESTION ---------------------------------------------
# A question rarely uses the words the documents use. Each rewrite is searched
# separately and the results fused; reranking stays against your original wording.
EXPAND_QUERIES=3
EXPAND_WITH_MODEL=true
EXPAND_TIMEOUT=12
# blended  - may add general knowledge, under a clearly separated heading
# grounded - documents only, refuse when they do not hold the answer
ANSWER_MODE=blended

# A follow-up rarely repeats its subject ("and the second one?"). The question is
# compared against the previous one by meaning, and folded into it when they are
# about the same thing. Raise this if unrelated questions are being joined; lower
# it if follow-ups are being searched on their own and finding nothing.
FOLLOW_UP_SIMILARITY=0.50

# --- DEEP MODE ---------------------------------------------------------------
# One question that needs several facts ("how do X and Y compare?") is split into
# sub-questions, each searched separately, and the results interleaved so every
# part is represented rather than the strongest part taking all the room. It costs
# one extra model call and finds passages a single search misses.
DEEP_ENABLED=true
DEEP_MAX_PARTS=4
DEEP_PER_PART_K=4
DEEP_WORKERS=4
# Budget for the splitting call alone. If it runs out, the question is searched whole.
DEEP_TIMEOUT=20

# --- DIAGRAMS ----------------------------------------------------------------
# Answers may include a Mermaid flowchart where one explains better than prose --
# a process, a hierarchy, or where a file sits in the folder tree. Rendered by the
# page itself, with no library fetched from anywhere.
DIAGRAMS_ENABLED=true

# --- ANALYSIS ---------------------------------------------------------------
# The Analyse button: deterministic scans first, then an agent loop that follows up.
ANALYSIS_ENABLED=true
# Each loop step is a small structured decision and its latency multiplies by the
# step count, so this model is chosen for speed. Gemini's newer "thinking" Flash
# models measured 30-40s per call and spent their whole token budget on hidden
# reasoning; flash-lite answers the same prompt in ~2s.
AGENT_MODEL=custom::gemini-flash-lite-latest
# The report is one long piece of prose, so it goes to the stronger model.
ANSWER_MODEL=groq::openai/gpt-oss-120b
AGENT_MAX_STEPS=18
AGENT_MAX_SECONDS=240
# Free tiers rate limit per minute and a loop fires calls back to back.
PROVIDER_RPM=12
PROVIDER_RETRIES=2
# Writing the improvement plan reads every measured figure first, so it is the one
# call in the app allowed to take its time.
GAP_PLAN_TIMEOUT=90

# --- DASHBOARDS -------------------------------------------------------------
# Panels are saved questions, re-run live each time a dashboard is opened.
DASHBOARD_MAX_PANELS=24
PANEL_MAX_ROWS=500
PANEL_SQL_TIMEOUT=15
# A bar chart of 29,206 serial numbers is unreadable and slow, so a categorical
# axis keeps only the largest N and says how many were left out.
CHART_MAX_CATEGORIES=15
CHART_MAX_POINTS=400
# Chart types offered: stat, bar, hbar, sbar (stacked), line, area, donut,
# scatter, table. The natural choice comes from the result shape; you can override
# it per panel without losing the other options.

# --- TIMEOUTS ---------------------------------------------------------------
# REQUEST_TIMEOUT is the total budget for one answer - generous, because a local
# model on CPU is slow. The other two stop a *stalled* connection from consuming
# that whole budget: CONNECT_TIMEOUT bounds reaching the server, READ_TIMEOUT
# bounds the gap between streamed chunks. A dead endpoint now fails in seconds
# instead of locking the UI for ten minutes.
REQUEST_TIMEOUT=600
CONNECT_TIMEOUT=10
READ_TIMEOUT=90

# How long the indexed-file counts shown in the UI may be reused before being
# recounted. At two million chunks the count itself costs 173ms; this makes it free.
STATS_TTL=30

# --- SERVER -----------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# Browser origins allowed to call the API. The chat page is served by this same
# server, so it needs nothing else; widen this only if you serve a front end from
# somewhere else. Do not set it to "*" -- that lets any site open in the same
# browser read your documents through this port.
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Citation links open the source file. With this on, only files that are actually
# in the index can be opened, so the endpoint cannot be used to read the rest of
# your data folder.
OPEN_INDEXED_ONLY=true
